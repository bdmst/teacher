<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>천안불당중학교 - 상벌점 대시보드</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Noto Sans KR', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col hidden" id="dashboardBody">

  <!-- 상단 네비게이션 바 -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-blue-900 text-amber-300 flex items-center justify-center shadow-md">
            <i class="fa-solid fa-school text-lg"></i>
          </div>
          <div>
            <span class="font-extrabold text-slate-900 text-lg">천안불당중학교</span>
            <p class="text-[11px] text-slate-500 font-medium">학생 상벌점 관리 포털</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-xl">
            <div class="text-left">
              <div class="text-xs font-bold text-slate-800 flex items-center gap-1">
                <span id="headerUserName">선생님</span>
                <span id="headerUserBadge" class="text-[10px] bg-slate-200 text-slate-700 px-1.5 rounded font-semibold">교사</span>
              </div>
            </div>
          </div>
          <button onclick="handleLogout()" class="p-2 text-slate-400 hover:text-rose-600 transition">
            <i class="fa-solid fa-arrow-right-to-bracket text-base"></i>
          </button>
        </div>
      </div>
    </div>
    <!-- 탭 네비게이션 -->
    <div class="bg-slate-100 border-t border-slate-200 px-4 overflow-x-auto">
      <div class="max-w-7xl mx-auto flex gap-1 py-1.5 text-xs font-semibold whitespace-nowrap">
        <button onclick="setActiveTab('grant')" id="nav-grant" class="tab-btn active px-3.5 py-2 rounded-lg bg-white text-blue-700 shadow-xs">
          상벌점 부여
        </button>
        <button onclick="setActiveTab('records')" id="nav-records" class="tab-btn px-3.5 py-2 rounded-lg text-slate-600 hover:bg-white/60">
          상벌점 내역 및 통계
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 space-y-6">
    <!-- 상벌점 부여 화면 -->
    <section id="tab-grant-content" class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 tab-content">
      <h2 class="text-lg font-bold text-slate-900 mb-4"><i class="fa-solid fa-stamp text-blue-600"></i> 상벌점 부여</h2>
      <div class="text-slate-500 text-sm">
        (기존 상벌점 부여 폼 HTML 코드 영역이 들어갑니다. 편의를 위해 UI 뼈대만 배치했습니다. 실제 사용시 기존 index.html의 폼 구조를 복사해서 넣으시면 됩니다.)
      </div>
    </section>

    <!-- 상벌점 내역 및 통계 화면 -->
    <section id="tab-records-content" class="bg-white rounded-2xl border border-slate-200 shadow-xs p-6 tab-content hidden">
      <h2 class="text-lg font-bold text-slate-900 mb-4"><i class="fa-solid fa-list text-blue-600"></i> 상벌점 내역 및 통계</h2>
      <div class="text-slate-500 text-sm">
        (기존 내역 테이블 HTML 코드 영역이 들어갑니다.)
      </div>
    </section>
  </main>

  <script>
    const STORAGE_KEYS = {
      TEACHERS: 'BDS_TEACHERS',
      CURRENT_USER: 'BDS_CURRENT_USER',
      // 필요에 따라 기존 상수 추가 (STUDENTS, RECORDS 등)
    };

    let currentUser = null;

    // 인증 검사 (로그인 안되어있으면 index.html로 강제 이동)
    function checkAuthSession() {
      const savedUser = localStorage.getItem(STORAGE_KEYS.CURRENT_USER);
      if (savedUser) {
        try {
          currentUser = JSON.parse(savedUser);
          const teachers = JSON.parse(localStorage.getItem(STORAGE_KEYS.TEACHERS) || '[]');
          const matched = teachers.find(t => t.id === currentUser.id);
          
          if (matched && matched.status === 'approved') {
            currentUser = matched;
            
            // 로그인 확인 성공 시 UI 표시
            document.getElementById('dashboardBody').classList.remove('hidden');
            document.getElementById('headerUserName').textContent = currentUser.name;
            if(currentUser.role === 'admin') {
              document.getElementById('headerUserBadge').textContent = '최고관리자';
              document.getElementById('headerUserBadge').className = 'text-[10px] bg-indigo-100 text-indigo-800 px-1.5 rounded font-bold';
            }
            return;
          }
        } catch (e) {
          console.error(e);
        }
      }
      
      // 로그인이 안되어있거나 승인이 안된 경우 튕겨냄
      window.location.replace('index.html');
    }

    function handleLogout() {
      if (confirm('로그아웃 하시겠습니까?')) {
        localStorage.removeItem(STORAGE_KEYS.CURRENT_USER);
        window.location.href = 'index.html';
      }
    }

    function setActiveTab(tabName) {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active', 'bg-white', 'text-blue-700', 'shadow-xs');
        btn.classList.add('text-slate-600');
      });
      document.getElementById(`nav-${tabName}`).classList.add('active', 'bg-white', 'text-blue-700', 'shadow-xs');
      
      document.querySelectorAll('.tab-content').forEach(sec => sec.classList.add('hidden'));
      document.getElementById(`tab-${tabName}-content`).classList.remove('hidden');
    }

    // 시스템 부팅 (페이지 로드시 실행)
    window.addEventListener('DOMContentLoaded', () => {
      checkAuthSession();
      // 기존 refreshAllDataViews() 함수 등 실행
    });
  </script>
</body>
</html>
